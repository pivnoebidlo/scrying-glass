{
  "name": "scrying-glass",
  "productName": "Scrying Glass",
  "version": "0.68.0",
  "description": "A game master screen for tabletop sessions: portraits, maps, bestiary and initiative on a second monitor",
  "license": "GPL-3.0-or-later",
  "author": "pivnoebidlo <dima@niktokro.me>",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "import-srd": "node --no-warnings scripts/import-srd.ts",
    "import-compendium": "node --no-warnings scripts/import-compendium.ts",
    "build-fate": "node --no-warnings scripts/build-fate.ts",
    "build-fitd": "node --no-warnings scripts/build-fitd.ts",
    "import-pf2e": "node --no-warnings scripts/import-pf2e.ts",
    "build-content": "node --no-warnings scripts/build-content.ts",
    "build-mausritter": "node --no-warnings scripts/build-mausritter.ts",
    "postinstall": "node node_modules/electron/install.js",
    "icon": "electron scripts/render-icon.cjs",
    "dist": "electron-vite build && electron-builder",
    "test": "vitest run"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.55.0",
    "@scure/bip39": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
