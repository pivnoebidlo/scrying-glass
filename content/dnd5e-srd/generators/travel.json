     "default": 8,
     "min": 1,
     "max": 24
    },
    {
     "key": "road",
     "title": {
      "en": "Good road",
      "ru": "Хорошая дорога"
     },
     "type": "check",
     "default": 1,
     "only": [
      "dnd5e-2024"
     ],
     "when": "eq(by, 0)"
    },
    {
     "key": "difficult",
     "title": {
      "en": "Difficult terrain (half speed)",
      "ru": "Труднопроходимая местность (вдвое медленнее)"
     },
     "type": "check",
     "default": 0,
     "only": [
      "dnd5e-2014"
     ],
     "when": "eq(by, 0)"
    }
   ],
   "lets": [
    {
     "key": "hd",
     "formula": "max(1, min(24, round(hours)))"
    },
    {
     "key": "land",
     "formula": "eq(by, 0)"
    },
    {
     "key": "limit",
     "formula": "if(terrain_max, min(2, terrain_max - 1 + road), 2)"
    },
    {
     "key": "kept",
     "formula": "min(pace, limit)"
    },
    {
     "key": "capped",
     "formula": "land * gt(pace, kept)"
    },
    {
     "key": "half",
     "formula": "if(difficult, 0.5, 1)"
    },
    {
     "key": "rate_hour",
     "formula": "2 + kept"
    },
    {
     "key": "rate_day",
     "formula": "18 + 6 * kept"
    },
    {
     "key": "per_hour",
     "formula": "if(land, rate_hour * half, by_mph)"
    },
    {
     "key": "per_day",
     "formula": "if(land, if(ge(hd, 8), rate_day + (hd - 8) * rate_hour, rate_hour * hd) * half, per_hour * hd)"
    },
    {
     "key": "dist",
     "formula": "max(0, distance)"
    },
    {
     "key": "days",
     "formula": "floor(dist / per_day + 0.000000001)"
    },
    {
     "key": "rest",
     "formula": "dist - days * per_day"
    },
    {
     "key": "last",
     "formula": "if(gt(rest, 0.000000001), min(hd, ceil(rest / (per_day / hd) - 0.000000001)), 0)"
    },
    {
     "key": "none",
     "formula": "land * 0 + eq(days + last, 0)"
    }
   ],
   "picks": [
    {
     "key": "kept_title",
     "from": "pace",
     "at": "kept"
    }
   ],
