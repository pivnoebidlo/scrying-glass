{
 "title": {
  "en": "Mausritter tables",
  "ru": "Таблицы Mausritter"
 },
 "about": {
  "en": "The GM tables of the Mausritter SRD: pick a table and roll. Settlements, hexes, adventure sites with rooms, treasure, mice of the GM, adventure seeds, the weather and a reaction.",
  "ru": "Таблицы мастера из Mausritter SRD: выберите таблицу и бросьте. Поселения, гексы, места приключений с комнатами, сокровища, мыши мастера, завязки приключений, погода и реакция."
 },
 "generators": [
  {
   "id": "settlement",
   "title": {
    "en": "Settlement",
    "ru": "Поселение"
   },
   "steps": [
    {
     "let": "size",
     "dice": "2d6",
     "keep": "low",
     "count": 1
    },
    {
     "line": {
      "en": "Size",
      "ru": "Размер"
     },
     "table": "size",
     "row": "size - 1"
    },
    {
     "let": "gov",
     "dice": "d6",
     "quiet": true
    },
    {
     "line": {
      "en": "Governance",
      "ru": "Управление"
     },
     "table": "governance",
     "lookup": "gov + size"
    },
    {
     "line": {
      "en": "Inhabitants",
      "ru": "Жители"
     },
     "table": "inhabitants",
     "dice": "d20"
    },
    {
     "repeat": "1 + ge(size, 6)",
     "steps": [
      {
       "line": {
        "en": "Notable feature",
        "ru": "Особенность"
       },
       "table": "feature",
       "dice": "d20"
      }
     ]
    },
    {
     "repeat": "1 + ge(size, 5)",
     "steps": [
      {
       "line": {
        "en": "Industry",
        "ru": "Промысел"
       },
       "table": "industry",
       "dice": "d20"
      }
     ]
    },
    {
     "line": {
      "en": "On arrival",
      "ru": "Когда мыши прибывают"
     },
     "table": "event",
     "dice": "d20"
    },
    {
     "line": {
      "en": "Name",
      "ru": "Название"
     },
     "join": "name",
     "parts": [
      {
       "table": "names",
       "row": "d(12) - 1",
       "col": "d(2)"
      },
      {
       "table": "names",
       "row": "d(12) - 1",
       "col": "2 + d(2)"
      }
     ]
    },
    {
     "if": "ge(size, 3)",
     "then": [
      {
       "line": {
        "en": "Tavern",
        "ru": "Таверна"
       },
       "text": "{0} {1} · {2}",
       "parts": [
        {
         "table": "tavern",
         "row": "d(12) - 1",
         "col": "1"
        },
        {
         "table": "tavern",
         "row": "d(12) - 1",
         "col": "2"
        },
        {
         "table": "tavern",
         "row": "d(12) - 1",
         "col": "3"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "hex",
   "title": {
    "en": "Hex",
    "ru": "Гекс"
   },
   "steps": [
    {
     "let": "r",
     "dice": "d6"
    },
    {
     "let": "type",
     "table": "hexType",
     "lookup": "r"
    },
    {
     "line": {
      "en": "Hex type",
      "ru": "Вид гекса"
     },
     "table": "hexType",
     "row": "type"
    },
    {
     "let": "lm",
     "dice": "d20"
    },
    {
     "line": {
      "en": "Landmark",
      "ru": "Ориентир"
     },
     "table": "landmark",
     "row": "lm - 1",
     "col": "type + 1"
    },
    {
     "let": "a",
     "dice": "d6"
    },
    {
     "let": "b",
     "dice": "d8"
    },
    {
     "line": {
      "en": "Detail",
      "ru": "Подробность"
     },
     "table": "landmarkDetail",
     "group": [
      "a",
      "b"
     ]
    }
   ]
  },
  {
   "id": "site",
   "title": {
    "en": "Adventure site",
    "ru": "Место приключения"
   },
   "options": [
    {
     "key": "rooms",
     "title": {
      "en": "Rooms",
      "ru": "Комнат"
     },
     "type": "number",
     "default": 6,
     "min": 1,
     "max": 20
    }
   ],
   "steps": [
    {
     "line": {
      "en": "Built as",
      "ru": "Постройка"
     },
     "table": "construction",
     "dice": "d20"
    },
    {
     "line": {
      "en": "Ruined by",
      "ru": "Разрушение"
     },
     "table": "ruination",
     "dice": "d12"
    },
    {
     "line": {
      "en": "Inhabitants",
      "ru": "Обитатели"
     },
     "table": "denizens",
     "dice": "d10"
    },
    {
     "line": {
      "en": "Searching for or protecting",
      "ru": "Ищут или охраняют"
     },
     "table": "seeking",
     "dice": "d8"
    },
    {
     "line": {
      "en": "Secret",
      "ru": "Тайна"
     },
     "table": "secret",
     "dice": "d6"
    },
    {
     "repeat": "rooms",
     "as": "n",
     "steps": [
      {
       "let": "r",
       "dice": "d6"
      },
      {
       "let": "type",
       "table": "roomType",
       "lookup": "r"
      },
      {
       "let": "c",
       "dice": "d6",
       "quiet": true
      },
      {
       "let": "t",
       "dice": "d6",
       "quiet": true
      },
      {
       "let": "beast",
       "table": "roomCreature",
       "row": "c - 1",
       "col": "type + 1",
       "is": "X"
      },
      {
       "let": "loot",
       "table": "roomTreasure",
       "row": "t - 1",
       "col": "type + 1",
       "is": "X"
      },
      {
       "if": "eq(type, 0)",
       "then": [
        {
         "let": "v",
         "dice": "d20"
        },
        {
         "line": {
          "en": "Room {n}",
          "ru": "Комната {n}"
         },
         "sep": true,
         "parts": [
          {
           "table": "roomType",
           "row": "type"
          },
          {
           "table": "empty",
           "lookup": "v"
          }
         ],
         "notes": [
          {
           "if": "not(beast + loot)",
           "text": {
            "en": "no creature, no treasure",
            "ru": "ни существа, ни сокровища"
           }
          },
          {
           "if": "beast * not(loot)",
           "text": {
            "en": "a creature",
            "ru": "существо"
           }
          },
          {
           "if": "loot * not(beast)",
           "text": {
            "en": "treasure",
            "ru": "сокровище"
           }
          },
          {
           "if": "beast * loot",
           "text": {
            "en": "a creature and treasure",
            "ru": "существо и сокровище"
           }
          }
         ]
        }
       ]
      },
      {
