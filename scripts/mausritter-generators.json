    "en": "Treasure",
    "ru": "Сокровища"
   },
   "options": [
    {
     "key": "former",
     "title": {
      "en": "In a former settlement, castle or dungeon",
      "ru": "В бывшем поселении, замке или подземелье"
     },
     "type": "check",
     "default": false
    },
    {
     "key": "magical",
     "title": {
      "en": "In a highly magical area",
      "ru": "В месте, насыщенном магией"
     },
     "type": "check",
     "default": false
    },
    {
     "key": "guarded",
     "title": {
      "en": "Guarded by a great beast or a devious trap",
      "ru": "Охраняется огромным зверем или коварной ловушкой"
     },
     "type": "check",
     "default": false
    },
    {
     "key": "adversity",
     "title": {
      "en": "The mice overcame great adversity",
      "ru": "Мыши преодолели большие трудности"
     },
     "type": "check",
     "default": false
    }
   ],
   "footer": {
    "if": "total",
    "text": {
     "en": {
      "one": "{count} pip in total",
      "other": "{count} pips in total"
     },
     "ru": {
      "one": "{count} пипс всего",
      "few": "{count} пипса всего",
      "many": "{count} пипсов всего",
      "other": "{count} пипса всего"
     }
    }
   },
   "steps": [
    {
     "let": "total",
     "formula": "0"
    },
    {
     "repeat": "2 + former + magical + guarded + adversity",
     "steps": [
      {
       "let": "r",
       "dice": "d20"
      },
      {
       "let": "row",
       "table": "treasure",
       "lookup": "r"
      },
      {
       "if": "eq(row, 0)",
       "then": [
        {
         "let": "cursed",
         "formula": "eq(d(6), 1)"
        },
        {
         "line": {
          "en": "Treasure",
          "ru": "Сокровище"
         },
         "table": "treasure",
         "row": "row",
         "notes": [
          {
           "if": "cursed",
           "text": {
            "en": "cursed",
            "ru": "проклят"
           },
           "warn": true
          }
         ],
         "sub": [
          {
           "line": {
            "en": "Class",
            "ru": "Класс"
           },
           "table": "swordClass",
           "dice": "d6"
          },
          {
           "let": "s",
           "dice": "d10"
          },
          {
           "line": {
            "en": "Sword",
            "ru": "Меч"
           },
           "parts": [
            {
             "table": "sword",
             "row": "s - 1",
             "col": "1"
            },
            {
             "table": "sword",
             "row": "s - 1",
             "col": "2"
            }
           ]
          },
          {
           "if": "cursed",
           "then": [
            {
             "let": "k",
             "dice": "d6"
            },
            {
             "line": {
              "en": "Curse",
              "ru": "Проклятие"
             },
             "parts": [
              {
               "table": "curse",
               "row": "k - 1",
               "col": "1"
              },
              {
               "table": "curse",
               "row": "k - 1",
               "col": "2"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "if": "eq(row, 1)",
       "then": [
        {
         "line": {
          "en": "Treasure",
          "ru": "Сокровище"
         },
         "table": "treasure",
         "row": "row",
         "sub": [
          {
           "let": "s",
           "dice": "2d8"
          },
          {
           "line": {
            "en": "Spell",
            "ru": "Заклинание"
